<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyTitle>DriveBender End-to-End Tests</AssemblyTitle>
    <Company>»SynthelicZ«</Company>
    <Product>DriveBender End-to-End Test Suite</Product>
    <Description>Drives the shipped dbmount binary the way a user does: a real mount through the OS filesystem, and the management UI through HTTP and a real browser.</Description>
    <Copyright>Copyright © Hawkynt 2017-2026</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Deliberately NO project reference to the engine. These tests must exercise the SHIPPED
    artefact through its public surfaces (the CLI, the mounted filesystem, the HTTP API, the
    page) — linking the engine in would let them pass against code the user never runs, which is
    the exact failure mode this suite exists to catch.

    The path to the binary comes from the DBMOUNT_EXE environment variable, or is discovered
    under the mount project's output; see DbMount.ResolveExecutable.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Microsoft.Playwright.NUnit" Version="1.49.0" />
  </ItemGroup>
</Project>
